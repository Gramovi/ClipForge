    },
    {
      "id": "emoji",
      "name": "Emoji",
      "description": "Automatické emoji ke klíčovým slovům nad titulky.",
      "style": { "font": "nunito-black", "font_size": 80, "uppercase": false, "highlight_color": "#FFD400", "outline_width": 6, "words_per_group": 3, "animation": "pop", "emoji": true }
    },
    {
      "id": "highlight-keywords",
      "name": "Highlight Keywords",
      "description": "AI vybere klíčová slova a zvýrazní je barvou.",
      "style": { "font": "montserrat-black", "font_size": 80, "uppercase": true, "highlight_mode": "keywords", "highlight_color": "#39FF6A", "outline_width": 6, "words_per_group": 3, "animation": "pop", "active_scale": 1.08 }
    },
    {
      "id": "cinema",
      "name": "Cinema",
      "description": "Úzké filmové písmo Bebas Neue se stínem, prolínání.",
      "style": { "font": "bebas-neue", "font_size": 100, "uppercase": true, "letter_spacing": 3, "highlight_mode": "none", "outline_width": 0, "shadow_depth": 4, "shadow_opacity": 0.85, "words_per_group": 4, "animation": "fade" }
    },
    {
      "id": "impact-green",
      "name": "Impact Green",
      "description": "Úderné písmo Anton, aktivní slovo zeleně.",
      "style": { "font": "anton", "font_size": 92, "uppercase": true, "highlight_color": "#23E06C", "outline_width": 6, "shadow_depth": 4, "words_per_group": 1, "animation": "pop", "active_scale": 1.0 }
