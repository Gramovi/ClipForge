    { "id": "poppins-extrabold", "label": "Poppins ExtraBold", "family": "Poppins ExtraBold", "file": "Poppins-800.ttf", "weight": 800 },
    { "id": "inter-extrabold", "label": "Inter ExtraBold", "family": "Inter ExtraBold", "file": "Inter-800.ttf", "weight": 800 },
    { "id": "bebas-neue", "label": "Bebas Neue", "family": "Bebas Neue", "file": "BebasNeue-400.ttf", "weight": 400 },
    { "id": "anton", "label": "Anton", "family": "Anton", "file": "Anton-400.ttf", "weight": 400 },
    { "id": "oswald-bold", "label": "Oswald Bold", "family": "Oswald", "file": "Oswald-700.ttf", "weight": 700 },
    { "id": "bangers", "label": "Bangers", "family": "Bangers", "file": "Bangers-400.ttf", "weight": 400 },
    { "id": "roboto-bold", "label": "Roboto Bold", "family": "Roboto", "file": "Roboto-700.ttf", "weight": 700 },
    { "id": "archivo-black", "label": "Archivo Black", "family": "Archivo Black", "file": "ArchivoBlack-400.ttf", "weight": 400 },
    { "id": "rubik-extrabold", "label": "Rubik ExtraBold", "family": "Rubik ExtraBold", "file": "Rubik-800.ttf", "weight": 800 },
    { "id": "nunito-black", "label": "Nunito Black", "family": "Nunito Black", "file": "Nunito-900.ttf", "weight": 900 },
    { "id": "space-mono-bold", "label": "Space Mono Bold", "family": "Space Mono", "file": "SpaceMono-700.ttf", "weight": 700 }
  ],
  "defaults": {
    "font": "montserrat-black",
    "font_size": 78,
    "uppercase": false,
    "letter_spacing": 0,
    "text_color": "#FFFFFF",
    "highlight_color": "#FFD400",
    "highlight_mode": "active_word",
    "outline_color": "#000000",
    "outline_width": 5,
    "shadow_color": "#000000",
    "shadow_opacity": 0.6,
    "shadow_depth": 3,
    "background": { "enabled": false, "color": "#000000", "opacity": 0.6, "padding": 18 },
    "glow": { "enabled": false, "color": "#00E5FF", "strength": 8 },
    "gradient": { "enabled": false, "from": "#FF8A00", "to": "#FF2E93" },
    "position": "bottom",
    "offset_y": 0,
    "words_per_group": 3,
    "animation": "pop",
    "active_scale": 1.12,
    "emoji": false,
    "rotation": 0
  },
  "presets": [
