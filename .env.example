# ClipForge configuration. Copy to `.env` (never commit .env) and adjust.
# `docker compose up` works even without .env – then Anthropic is selected but no key is set
# and the app shows how to fix it.

# --- security -----------------------------------------------------------------
# Random string used to sign login sessions. CHANGE IT for any shared deployment:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-in-production-please
# set to true when served over HTTPS
COOKIE_SECURE=false
ALLOW_REGISTRATION=true
# public URL of the web app (used for CORS)
PUBLIC_URL=http://localhost:3000

# --- AI provider for finding moments ---------------------------------------------
# anthropic (default, best quality) | ollama (local, free)
LLM_PROVIDER=anthropic
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
# claude-sonnet-5-5 = best quality ($2 / $10 per 1M tokens)
# claude-haiku-5-5  = cheapest   ($0.10 / $0.50 per 1M tokens)
ANTHROPIC_MODEL=claude-sonnet-5-5
# low | medium | high – how hard the model thinks (affects cost and quality)
ANTHROPIC_EFFORT=medium

# Ollama (start with: docker compose --profile ollama up)
OLLAMA_BASE_URL=http://ollama:11434
# qwen2.5:7b ~ 5 GB RAM; qwen2.5:14b ~ 10 GB (better Czech); llama3.1:8b; qwen2.5:3b (fast, weak)
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_NUM_CTX=16384

# moment finding: transcript windows (minutes) with overlap so nothing is lost on the edges
LLM_WINDOW_MINUTES=12
LLM_WINDOW_OVERLAP_MINUTES=1.5
LLM_MAX_RETRIES=4
LLM_CONCURRENCY=2

# --- transcription (faster-whisper) ----------------------------------------------------
# For Czech use large-v3 (best) or large-v3-turbo (faster, nearly as good).
# medium/small run faster on CPU but make many more mistakes in Czech.
WHISPER_MODEL=large-v3
# auto | cpu | cuda
WHISPER_DEVICE=auto
# auto (int8 on CPU, float16 on GPU) | int8 | float16 | int8_float16
WHISPER_COMPUTE_TYPE=auto
WHISPER_BEAM_SIZE=5

# --- uploads ---------------------------------------------------------------------
# 5 GB
MAX_UPLOAD_BYTES=5368709120
# 8 MB chunks for resumable uploads (must stay below the proxy body limit of 64 MB)
UPLOAD_CHUNK_BYTES=8388608
# 4 hours
MAX_VIDEO_SECONDS=14400
ALLOW_URL_IMPORT=true

# --- rendering ---------------------------------------------------------------------
# slow = best quality/size; medium = ~2x faster; veryfast for testing
X264_PRESET=slow
X264_CRF=18
AUDIO_BITRATE=192k
# render every clip right after processing (otherwise only on demand / export)
RENDER_ON_PROCESS=true
FACE_SAMPLE_FPS=5

# --- ports ---------------------------------------------------------------------------
WEB_PORT=3000
API_PORT=8000
